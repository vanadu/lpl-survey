{
  "name": "PROCEDURE-page",
  "elements": [
    {
      "type": "panel",
      "name": "ProcedureCard1Panel",
      "elements": [
        {
          "type": "html",
          "name": "ProcedureHeading",
          "html": "<h2>Veterinary-Medical Procedures for&nbsp;LP</h2>"
        },
        {
          "type": "html",
          "name": "ProcedureText",
          "html": "<p>This section asks questions about veterinary procedures such as surgery or stent implant that {CmpnName} underwent to treat laryngeal paralysis. </p>"
        },

        {
          "type": "boolean",
          "name": "ProcedureDidHave",
          "title": "Did {CmpnName} undergo a veterinary-medical procedure such as surgery or a stent implant for LP/GOLPP?",
          "isRequired": true,
          "labelTrue": "Yes",
          "labelFalse": "No",
          "swapOrder": true
        },

        {
          "type": "panel",
          "name": "ProcedureTypePanel",
          "elements": [
            {
            "type": "checkbox",
            "name": "ProcedureType",
            "title": "What kind of procedure or procedures did {CmpnName} have?",
            "description": "Please check all that apply.",
            "isRequired": true,
            "visibleIf": "{ProcedureDidHave} = true",
            "choices": [
              {
                "value": "UAL",
                "text": "Tieback (Unilateral Arytenoid Lateralization)"
              },
              {
                "value": "BVEAP",
                "text": "BVEAP (Bilateral Vocal Fold Excision & Arytenoid Pexy)"
              },
              {
                "value": "ESI",
                "text": "Laryngeal stent"
              },
              { "value": "PAE",
                "text": "Partial arytenoidectomy"  
              },
              { "value": "VCC",
                "text": "Ventrilocordectomy"  
              },
              { "value": "PLE",
                "text": "Partial Laryngectomy"  
              },
              { "value": "TT",
                "text": "Tracheostomy"  
              }
            ],
            "showOtherItem": true
            },
            {
              "type": "ranking",
              "name": "ProcedureSequence",
              "title": "In what order were these procedures performed?",
              "description": "Please drag and drop the procedures into the order in which they were performed, first to last.",
              "choicesFromQuestion": "ProcedureType",
              "choicesFromQuestionMode": "selected",
              "hideIfChoicesEmpty": true,
              "visibleIf": "{ProcedureType.length} > 1"
            }
          ]
        },

        {
          "type": "panel",
          "name": "ProcedureUALCard1Panel",
          "title": "Questions about {CmpnName}'s tieback (UAL) surgery:",
          "elements": [
            {
              "type": "panel",
              "name": "ProcedureUALAgePanel",
              "elements": [
                {
                  "type": "panel",
                  "name": "ProcedureUALAgeDetailsPanel",
                  "title": "At about what age did {CmpnName} have the first procedure for LP/ GOLPP?",
                  "description": "Please enter years and months.",
                  "visibleIf": "{ProcedureDidHave} = true",
                  "elements": [
                    {
                      "type": "text",
                      "inputType": "number",
                      "name": "ProcedureUALAgeYears",
                      "title": "Years",
                      "isRequired": true,
                      "min": "1",
                      "max": "40",
                        "validators": [
                        {
                          "type": "numeric",
                          "minValue": 1,
                          "maxValue": 40,
                          "text": "Age must be between 1 and 40"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "inputType": "number",
                      "name": "ProcedureUALAgeMonths",
                      "title": "Months (0 - 11)",
                      "isRequired": true,
                      "min": 0,
                      "max": 11,
                      "validators": [
                        {
                          "type": "numeric",
                          "minValue": 0,
                          "maxValue": 11,
                          "text": "Months must be between 0 and 11"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "boolean",
                  "name": "ProcedureUALScheduled",
                  "title": "Was it a scheduled procedure or an emergency procedure due to an LP-induced breathing crisis?",
                  "isRequired": true,
                  "visibleIf": "{ProcedureDidHave} = true",
                  "labelTrue": "Scheduled",
                  "labelFalse": "Emergency",
                  "swapOrder": true
                },
                {
                "type": "dropdown",
                "name": "ProcedureUALScheduledWait",
                "title": "How far in advance was the procedure scheduled?",
                "isRequired": true,
                "visibleIf": "{ProcedureDidHave} = true && {ProcedureUALScheduled} = true",
                "choices": [
                  {
                    "value": "LESS_THAN_TWO_WEEKS",
                    "text": "Less than two weeks"
                  },
                  {
                    "value": "TWO_TO_FOUR_WEEKS",
                    "text": "Two to four weeks"
                  },
                  {
                    "value": "FOUR_TO_EIGHT_WEEKS",
                    "text": "Four to eight weeks"
                  },
                  {
                    "value": "OVER_EIGHT_WEEKS",
                    "text": "More than eight weeks"
                  }
                ],
                "showOtherItem": false
                }
              ]
            },
            {
              "type": "panel",
              "name": "ProcedureUALSignsPanel",
              "elements": [
                {
                  "type": "radiogroup",
                  "name": "ProcedureUALCough",
                  "title": "Did {CmpnName} have a persistent cough following the procedure?",
                  "choices": [
                    {
                      "value": "YES",
                      "text": "Yes"
                    },
                    {
                      "value": "NO",
                      "text": "No"
                    },
                    {
                      "value": "DONT_KNOW",
                      "text": "Don't know"
                    }
                  ]
                },
                {
                  "type": "rating",
                  "name": "ProcedureUALCoughRating",
                  "title": "Did the cough improve or get worse over time?",
                  "description": "1 = much worse, 3 = no change, 5 = got much better",
                  "isRequired": true,
                  "visibleIf": "{ProcedureUALCough} = 'YES'",
                  "rateValues": [
                    { "value": 1, "text": "1" },
                    { "value": 2, "text": "2" },
                    { "value": 3, "text": "3" },
                    { "value": 4, "text": "4" },
                    { "value": 5, "text": "5" }
                  ]
                },                
                {
                  "type": "radiogroup",
                  "name": "ProcedureUALGagRetch",
                  "title": "Did {CmpnName} gag or retch frequently following the procedure?",
                  "choices": [
                    {
                      "value": "YES",
                      "text": "Yes"
                    },
                    {
                      "value": "NO",
                      "text": "No"
                    },
                    {
                      "value": "DONT_KNOW",
                      "text": "Don't know"
                    }
                  ]
                },
                {
                  "type": "rating",
                  "name": "ProcedureUALGagRetchRating",
                  "title": "Did the gagging or retching improve or get worse over time?",
                  "description": "1 = much worse, 3 = no change, 5 = got much better",
                  "isRequired": true,
                  "visibleIf": "{ProcedureUALGagRetch} = 'YES'",
                  "rateValues": [
                    { "value": 1, "text": "1" },
                    { "value": 2, "text": "2" },
                    { "value": 3, "text": "3" },
                    { "value": 4, "text": "4" },
                    { "value": 5, "text": "5" }
                  ]
                },


                {
                  "type": "radiogroup",
                  "name": "ProcedureUALRegurgitate",
                  "title": "Did {CmpnName} frequently regurgitate food or water following the procedure?",
                  "choices": [
                    {
                      "value": "YES",
                      "text": "Yes"
                    },
                    {
                      "value": "NO",
                      "text": "No"
                    },
                    {
                      "value": "DONT_KNOW",
                      "text": "Don't know"
                    }
                  ]
                },
                {
                  "type": "rating",
                  "name": "ProcedureUALRegurgitateRating",
                  "title": "Did the regurgitation improve or get worse over time?",
                  "description": "1 = much worse, 3 = no change, 5 = got much better",
                  "isRequired": true,
                  "visibleIf": "{ProcedureUALRegurgitate} = 'YES'",
                  "rateValues": [
                    { "value": 1, "text": "1" },
                    { "value": 2, "text": "2" },
                    { "value": 3, "text": "3" },
                    { "value": 4, "text": "4" },
                    { "value": 5, "text": "5" }
                  ]
                },


                {
                  "type": "radiogroup",
                  "name": "ProcedureUALMucus",
                  "title": "Did frequently {CmpnName} cough up mucus or phlegm after the procedure?",
                  "choices": [
                    {
                      "value": "YES",
                      "text": "Yes"
                    },
                    {
                      "value": "NO",
                      "text": "No"
                    },
                    {
                      "value": "DONT_KNOW",
                      "text": "Don't know"
                    }
                  ]
                },
                {
                  "type": "rating",
                  "name": "ProcedureUALMucusRating",
                  "title": "Did the mucus or phlegm improve or get worse over time?",
                  "description": "1 = much worse, 3 = no change, 5 = got much better",
                  "isRequired": true,
                  "visibleIf": "{ProcedureUALMucus} = 'YES'",
                  "rateValues": [
                    { "value": 1, "text": "1" },
                    { "value": 2, "text": "2" },
                    { "value": 3, "text": "3" },
                    { "value": 4, "text": "4" },
                    { "value": 5, "text": "5" }
                  ]
                }
              ]
            }
          ]
        },

        {
          "type": "panel",
          "name": "ProcedureEFIPanel",
          "visibleIf": "{ProcedureDidHave} = true && {ProcedureType} contains 'EFI'",
          "elements": [

            {
              "type": "dropdown",
              "name": "ProcedureEFIType",
              "title": "What type of stent implant did {CmpnName} receive?",
              "isRequired": true,
              "choices": [
                {
                  "value": "SILICONE",
                  "text": "Silicone"
                },
                {
                  "value": "DEXSTENT",
                  "text": "Dextronix DexStent LE Nitinol wire"
                },
                {
                  "value": "NITINOL_MESH",
                  "text": "Nitinol mesh"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ],
              "showOtherItem": true
            },
            {
              "type": "panel",
              "name": "ProcedureEFIDexstentPanel",
              "visibleIf": "{ProcedureEFIType} contains 'DEXSTENT'",
              "elements": [
                {
                  "type": "html",
                  "name": "ProcedureEFIDexstentText",
                  "html": "<b>IMPORTANT</b>: The Dextronix DexStent LE Nitinol wire stent device has been discontinued by the manufacturer. Report parties involved in the sale or use of this device to your local veterinary regulatory agency."
                }
              ]
            }
          ]
        },

        {
          "type": "panel",
          "name": "ProcedureBVEAPPanel",
