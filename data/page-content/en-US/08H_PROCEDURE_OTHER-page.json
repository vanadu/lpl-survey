{
  "name": "PROCEDURE_Other-page",
  "visibleIf": "{ProcedureDidHave} = true and {ProcedureType} contains 'Other'",
  "elements": [
    {
      "type": "panel",
      "name": "ProcedureOtherCard1Panel",
      "elements": [
        {
              "type": "html",
              "name": "ProcedureOtherHeading",
              "html": "<h2>Questions About {CmpnName}'s LP Surgery<h2>"
        },
        {
              "type": "html",
              "name": "ProcedureOtherText",
              "html": "<p>If you're not sure what kind of surgery or procedure {CmpnName} had, please fill out the survey as best as you can.</p>"
        },
        {
          "type": "panel",
          "name": "ProcedureOtherAgePanel",
          "title": "About how old was {CmpnName} when {cvGenderSubjectPronoun} had the LP surgery?",
          "elements": [
            {
              "type": "panel",
              "name": "ProcedureOtherAgeDetailsPanel",
              "description": "Please enter years and months.",
              "visibleIf": "{ProcedureDidHave} = true",
              "elements": [
                {
                  "type": "text",
                  "inputType": "number",
                  "name": "ProcedureOtherAgeYears",
                  "title": "Years",
                  "isRequired": true,
                  "min": "1",
                  "max": "40",
                    "validators": [
                    {
                      "type": "numeric",
                      "minValue": 1,
                      "maxValue": 40,
                      "text": "Age must be between 1 and 40"
                    }
                  ]
                },
                {
                  "type": "text",
                  "inputType": "number",
                  "name": "ProcedureOtherAgeMonths",
                  "title": "Months (0 - 11)",
                  "isRequired": true,
                  "min": 0,
                  "max": 11,
                  "validators": [
                    {
                      "type": "numeric",
                      "minValue": 0,
                      "maxValue": 11,
                      "text": "Months must be between 0 and 11"
                    }
                  ]
                }
              ]
            },
            {
              "type": "boolean",
              "name": "ProcedureOtherScheduled",
              "title": "Was it a scheduled procedure or an emergency procedure due to an LP-induced breathing crisis?",
              "isRequired": true,
              "visibleIf": "{ProcedureDidHave} = true",
              "labelTrue": "Scheduled",
              "labelFalse": "Emergency",
              "swapOrder": true
            },
            {
            "type": "dropdown",
            "name": "ProcedureOtherScheduledWait",
            "title": "How far in advance was the procedure scheduled?",
            "isRequired": true,
            "visibleIf": "{ProcedureDidHave} = true && {ProcedureOtherScheduled} = true",
            "choices": [
              {
                "value": "LESS_THAN_TWO_WEEKS",
                "text": "Less than two weeks"
              },
              {
                "value": "TWO_TO_FOUR_WEEKS",
                "text": "Two to four weeks"
              },
              {
                "value": "FOUR_TO_EIGHT_WEEKS",
                "text": "Four to eight weeks"
              },
              {
                "value": "OVER_EIGHT_WEEKS",
                "text": "More than eight weeks"
              }
            ],
            "showOtherItem": false
            },
            {
              "type": "radiogroup",
              "name": "ProcedureOtherDifference",
              "title": "Did the surgeon explain the difference between the surgery {CmpnName} had other surgery or procedure types?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },

            {
              "type": "radiogroup",
              "name": "ProcedureOtherLaser",
              "title": "Was the LP surgery {CmpnName} had performed with a laser?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },

            {
              "type": "radiogroup",
              "name": "ProcedureOtherChoice",
              "title": "Did the surgeon offer you a choice between the surgery type {CmpnName} had and any other procedure type?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            }
          ]
        },
        {
          "type": "panel",
          "name": "ProcedureOtherSurgeryPanel",
          "elements": [
            {
              "type": "html",
              "name": "ProcedureOtherPostOpHeading",
              "html": "<h4>These questions ask about issues {CmpnName} had immediately after surgery.</h4>"
            },
            {
              "type": "radiogroup",
              "name": "ProcedureOtherIncisionComplications",
              "title": "Did {CmpnName} have any infection or swelling at the incision site?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },
            {
              "type": "radiogroup",
              "name": "ProcedureOtherOralBleeding",
              "title": "Did {CmpnName} have bleeding in the mouth or from the inside the throat?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },

            {
              "type": "radiogroup",
              "name": "ProcedureOtherComplications",
              "title": "Were there unexpected complications during or immediately after the surgery?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },


            
            {
              "type": "radiogroup",
              "name": "ProcedureOtherExtendedStay",
              "title": "Did {CmpnName} need to stay longer than expected at the hospital after the procedure?",
              "isRequired": true,
              "choices": [
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "ONE_DAY",
                  "text": "Yes, one extra day"
                },
                {
                  "value": "TWO_DAYS",
                  "text": "Yes, two days"
                },
                {
                  "value": "THREE_DAYS",
                  "text": "Yes, three days or more"
                }
              ],
              "showOtherItem": false
            },
            {
              "type": "checkbox",
              "name": "ProcedureOtherComplicationsType",
              "title": "What was the nature of the complications that occurred during or immediately after the surgery?",
              "isRequired": true,
              "visibleIf": "{ProcedureOtherComplications} = 'YES'",
              "choices": [
                {
                  "value": "ASPIRATION",
                  "text": "Aspiration pneumonia"
                },
                {
                  "value": "ANESTHESIA",
                  "text": "Adverse reaction to anesthesia"
                },
                {
                  "value": "SUTURE_FAILURE",
                  "text": "Suture failure"
                },
                {
                  "value": "RESPIRATORY",
                  "text": "Respiratory crisis"
                },
                {
                  "value": "STROKE",
                  "text": "Stroke or cardiac event"
                },
                { 
                  "value": "DONT_KNOW",
                  "text": "Don't know or prefer not to say"
                }
              ],
              "showOtherItem": true
            },

            {
              "type": "radiogroup",
              "name": "ProcedureOtherFollowupCare",
              "title": "In the four weeks after surgery, did {CmpnName} need another visit to a veterinary professional because of complications?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ],
              "showOtherItem": false
            },
            {
              "type": "radiogroup",
              "name": "ProcedureOtherMedications",
              "title": "Were prescription medications provided for {CmpnName} after the procedure?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },
            {
              "type": "checkbox",
              "name": "ProcedureOtherMedicationsType",
              "title": "What medications were prescribed or provided for {CmpnName} after the procedure?",
              "isRequired": true,
              "visibleIf": "{ProcedureOtherMedications} = 'YES'",              
              "choices": [
                {
                  "value": "PAIN",
                  "text": "Pain medications (i.e. acetaminophen, paracetamol or other NSAID, opiods)"
                },
                {
                  "value": "REFLUX",
                  "text": "Reflux medications (i.e. cisipride, famotidine, omeprazole)"
                },
                {
                  "value": "ANTIBIOTICS",
                  "text": "Antibiotics"
                },
                {
                  "value": "STEROID",
                  "text": "Steroid (i.e. prednisone, meloxicam, metacam)"
                },
                {
                  "value": "SEDATIVE",
                  "text": "Sedative (i.e. trazodone, gabapentin, acepromazine)"
                },
                {
                  "value": "MAROPITANT",
                  "text": "Cerenia (maropitant citrate)"
                },
                {
                  "value": "COUGH_SUPPRESSANT",
                  "text": "Cough suppressants (i.e. codeine, dextromethorphan, guaifenesin)"
                }
              ],
              "showOtherItem": true
            }
          ]
        },

        {
          "type": "panel",
          "name": "ProcedureOtherCostPanel",
          "elements": [
            {
              "type": "html",
              "name": "ProcedureOtherCostHeading",
              "html": "<h4>These questions are about the approximate cost of the surgery. Rough estimates are fine.</h4>"
            },
            {
              "type": "dropdown",
              "name": "ProcedureOtherCost",
              "title": "About what was the cost of the surgery, not including post-operative complications?",
              "description": "Please provide the pre-insurance cost, not the out-of-pocket cost.",
              "isRequired": true,
              "visibleIf": "{ProcedureDidHave} = true",
              "choices": [
                {
                  "value": "NOT_SAY",
                  "text": "Don't know or prefer not to say"
                },
                {
                  "value": "UNDER_1500",
                  "text": "Under $1500"
                },
                {
                  "value": "1500_3000",
                  "text": "$1500 - $3000"
                },
                {
                  "value": "3000_5000",
                  "text": "$3000 - $5000"
                },
                {
                  "value": "5000_7000",
                  "text": "$5000 - $7000"
                },
                {
                  "value": "7000_9000",
                  "text": "$7000 - $9000"
                },
                {
                  "value": "OVER_9000",
                  "text": "Over $9000"
                }
              ],
              "showOtherItem": false
            },
            {
              "type": "dropdown",
              "name": "ProcedureOtherFollowupCost",
              "title": "About what was total cost of the complications of the surgery?",
              "description": "Please provide the pre-insurance cost, not the out-of-pocket cost.",
              "isRequired": true,
              "visibleIf": "{ProcedureOtherFollowupCare} = 'YES'",
              "choices": [
                {
                  "value": "NOT_SAY",
                  "text": "Don't know or prefer not to say"
                },
                {
                  "value": "UNDER_500",
                  "text": "Under $500"
                },
                {
                  "value": "500_1000",
                  "text": "$500 - $1000"
                },
                {
                  "value": "1000_2000",
                  "text": "$1000 - $2000"
                },
                {
                  "value": "2000_3000",
                  "text": "$2000 - $3000"
                },
                {
                  "value": "3000_5000",
                  "text": "$3000 - $5000"
                },
                {
                  "value": "OVER_5000",
                  "text": "Over $5000"
                }
              ],
              "showOtherItem": false
            }
          ]
        }


      ]
    },

    {
      "type": "panel",
      "name": "ProcedureOtherCard2Panel",
      "elements": [
        {
          "type": "panel",
          "name": "ProcedureOtherConditionPanel",
          "elements": [
            {
              "type": "html",
              "name": "ProcedureOtherConditionHeading",
              "html": "<h4>These questions are about {CmpnName}'s condition in the weeks after the surgery.</h4>"
            },
    

            {
              "type": "rating",
              "name": "ProcedureOtherBreathingPostOp",
              "title": "How would you rate {CmpnName}'s breathing in the time right after the LP surgery?",
              "description": "1 = no improvement, 3 = moderate improvement, 5 = very much improved",
              "isRequired": true,
              "rateValues": [
                { "value": 1, "text": "1" },
                { "value": 2, "text": "2" },
                { "value": 3, "text": "3" },
                { "value": 4, "text": "4" },
                { "value": 5, "text": "5" }
              ]
            },


            {
              "type": "radiogroup",
              "name": "ProcedureOtherCoughGagRetch",
              "title": "Did {CmpnName} cough, gag, or retch more than before the procedure?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },
            {
              "type": "rating",
              "name": "ProcedureOtherCoughGagRetchChange",
              "title": "Did the coughing, gagging or retching get worse or better with time?",
              "description": "1 = much worse, 3 = stayed about the same, 5 = got much better",
              "isRequired": true,
              "visibleIf": "{ProcedureOtherCoughGagRetch} = 'YES'",
              "rateValues": [
                { "value": 1, "text": "1" },
                { "value": 2, "text": "2" },
                { "value": 3, "text": "3" },
                { "value": 4, "text": "4" },
                { "value": 5, "text": "5" }
              ]
            },
            {
              "type": "radiogroup",
              "name": "ProcedureOtherBadBreath",
              "title": "Did {CmpnName} develop bad breath after the procedure?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },
            {
              "type": "rating",
              "name": "ProcedureOtherBadBreathChange",
              "title": "Did the bad breath get worse or better over time?",
              "description": "1 = much worse, 3 = stayed about the same, 5 = got much better",
              "isRequired": true,
              "visibleIf": "{ProcedureOtherBadBreath} = 'YES'",
              "rateValues": [
                { "value": 1, "text": "1" },
                { "value": 2, "text": "2" },
                { "value": 3, "text": "3" },
                { "value": 4, "text": "4" },
                { "value": 5, "text": "5" }
              ]
            },
            {
              "type": "radiogroup",
              "name": "ProcedureOtherRegurgitate",
              "title": "Did {CmpnName} regurgitate food or water more frequently than before the procedure?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },
            {
              "type": "rating",
              "name": "ProcedureOtherRegurgitateChange",
              "title": "Did the regurgitating get worse or better over time?",
              "description": "1 = much worse, 3 = stayed about the same, 5 = much better",
              "isRequired": true,
              "visibleIf": "{ProcedureOtherRegurgitate} = 'YES'",
              "rateValues": [
                { "value": 1, "text": "1" },
                { "value": 2, "text": "2" },
                { "value": 3, "text": "3" },
                { "value": 4, "text": "4" },
                { "value": 5, "text": "5" }
              ]
            },
            {
              "type": "radiogroup",
              "name": "ProcedureOtherMucus",
              "title": "Did {CmpnName} cough up mucus or phlegm more frequently than before the procedure?",
              "isRequired": true,
              
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },
            {
              "type": "rating",
              "name": "ProcedureOtherMucusChange",
              "title": "Did the mucus or phlegm production get worse or better over time?",
              "description": "1 = much worse, 3 = stayed about the same, 5 = much better",
              "isRequired": true,
              "visibleIf": "{ProcedureOtherMucus} = 'YES'",
              "rateValues": [
                { "value": 1, "text": "1" },
                { "value": 2, "text": "2" },
                { "value": 3, "text": "3" },
                { "value": 4, "text": "4" },
                { "value": 5, "text": "5" }
              ]
            }
          ]
        },
        {
          "type": "panel",
          "name": "ProcedureOtherLongTermPanel",
          "elements": [
            {
              "type": "html",
              "name": "ProcedureOtherLongTermHeading",
              "html": "<h4>These questions are about the long-term effects of {CmpnName}'s LP surgery.</h4>"
            },
            {
              "type": "radiogroup",
              "name": "ProcedureOtherBreathingLongTerm",
              "title": "In the long-term, how did {CmpnName}'s breathing change over time after the surgery?",
              "isRequired": true,
              "choices": [
                {
                  "value": "NO_CHANGE",
                  "text": "No change"
                },
                {
                  "value": "PROGRESSIVELY_BETTER",
                  "text": "Got progressively better over time"
                },
                {
                  "value": "PROGRESSIVELY_WORSE",
                  "text": "Got progressively worse over time"
                },
                {
                  "value": "SYMPTOMS_RETURNED",
                  "text": "After initial improvement, all the LP symptoms returned"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },
            {
              "type": "dropdown",
              "name": "ProcedureOtherSymptomsReturnedTime",
              "title": "How long did it take for the LP symptoms to return?",
              "isRequired": true,
              "visibleIf": "{ProcedureOtherBreathingLongTerm} = 'SYMPTOMS_RETURNED'",
              "choices": [
                {
                  "value": "IMMEDIATELY",
                  "text": "Almost immediately"
                },
                {
                  "value": "WEEKS",
                  "text": "Several weeks"
                },
                {
                  "value": "MONTHS",
                  "text": "Several months"
                },
                {
                  "value": "YEAR",
                  "text": "Over a year"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't remember or don't know"
                }
              ],
              "showOtherItem": false
            },
            {
              "type": "rating",
              "name": "ProcedureOtherSatisfaction",
              "title": "How would you rate your satisfaction with the procedure {CmpnName} had?",
              "description": "1 = not at all satisfied, 3 = moderately satisfied, 5 = very satisfied",
              "isRequired": true,
              "rateValues": [
                { "value": 1, "text": "1" },
                { "value": 2, "text": "2" },
                { "value": 3, "text": "3" },
                { "value": 4, "text": "4" },
                { "value": 5, "text": "5" }
              ]
            }
          ]
        }
      ]
    }
  ]
}