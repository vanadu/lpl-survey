{
  "name": "PROCEDURE-page",
  "elements": [
    {
      "type": "panel",
      "name": "ProcedureCard1Panel",
      "elements": [
        {
          "type": "html",
          "name": "ProcedureHeading",
          "html": "<h2>Veterinary-Medical Procedures for&nbsp;LP</h2>"
        },
        {
          "type": "html",
          "name": "ProcedureText",
          "html": "<p>This section asks questions about veterinary procedures such as surgery or stent implant that {CmpnName} underwent to treat laryngeal paralysis. </p>"
        },

        {
          "type": "boolean",
          "name": "ProcedureDidHave",
          "title": "Did {CmpnName} undergo a veterinary-medical procedure such as surgery or a stent implant for LP/GOLPP?",
          "isRequired": true,
          "labelTrue": "Yes",
          "labelFalse": "No",
          "swapOrder": true
        },

        {
          "type": "panel",
          "name": "ProcedureTypePanel",
          "elements": [
            {
            "type": "checkbox",
            "name": "ProcedureType",
            "title": "What kind of procedure or procedures did {CmpnName} have?",
            "description": "Please check all that apply.",
            "isRequired": true,
            "visibleIf": "{ProcedureDidHave} = true",
            "choices": [
              {
                "value": "UAL",
                "text": "Tieback (Unilateral Arytenoid Lateralization)"
              },
              {
                "value": "BVEAP",
                "text": "BVEAP (Bilateral Vocal Fold Excision & Arytenoid Pexy)"
              },
              {
                "value": "ESI",
                "text": "Laryngeal stent"
              },
              { "value": "PAE",
                "text": "Partial arytenoidectomy"  
              },
              { "value": "VCC",
                "text": "Ventrilocordectomy"  
              },
              { "value": "PLE",
                "text": "Partial Laryngectomy"  
              },
              { "value": "TT",
                "text": "Tracheostomy"  
              }
            ],
            "showOtherItem": true
            },
            {
              "type": "ranking",
              "name": "ProcedureSequence",
              "title": "In what order were these procedures performed?",
              "description": "Please drag and drop the procedures into the order in which they were performed, first to last.",
              "choicesFromQuestion": "ProcedureType",
              "choicesFromQuestionMode": "selected",
              "hideIfChoicesEmpty": true,
              "visibleIf": "{ProcedureType.length} > 1"
            }
          ]
        },



        {
          "type": "panel",
          "name": "ProcedureUALCard1Panel",
          "elements": [
            {
                  "type": "html",
                  "name": "ProcedureUALHeading",
                  "html": "<h3>Questions About {CmpnName}'s Tieback (UAL) Surgery<h3>"
            },
            {
              "type": "panel",
              "name": "ProcedureUALAgePanel",
              "elements": [
                {
                  "type": "panel",
                  "name": "ProcedureUALAgeDetailsPanel",
                  "title": "At about what age did {CmpnName} have the first procedure for LP/ GOLPP?",
                  "description": "Please enter years and months.",
                  "visibleIf": "{ProcedureDidHave} = true",
                  "elements": [
                    {
                      "type": "text",
                      "inputType": "number",
                      "name": "ProcedureUALAgeYears",
                      "title": "Years",
                      "isRequired": true,
                      "min": "1",
                      "max": "40",
                        "validators": [
                        {
                          "type": "numeric",
                          "minValue": 1,
                          "maxValue": 40,
                          "text": "Age must be between 1 and 40"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "inputType": "number",
                      "name": "ProcedureUALAgeMonths",
                      "title": "Months (0 - 11)",
                      "isRequired": true,
                      "min": 0,
                      "max": 11,
                      "validators": [
                        {
                          "type": "numeric",
                          "minValue": 0,
                          "maxValue": 11,
                          "text": "Months must be between 0 and 11"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "boolean",
                  "name": "ProcedureUALScheduled",
                  "title": "Was it a scheduled procedure or an emergency procedure due to an LP-induced breathing crisis?",
                  "isRequired": true,
                  "visibleIf": "{ProcedureDidHave} = true",
                  "labelTrue": "Scheduled",
                  "labelFalse": "Emergency",
                  "swapOrder": true
                },
                {
                "type": "dropdown",
                "name": "ProcedureUALScheduledWait",
                "title": "How far in advance was the procedure scheduled?",
                "isRequired": true,
                "visibleIf": "{ProcedureDidHave} = true && {ProcedureUALScheduled} = true",
                "choices": [
                  {
                    "value": "LESS_THAN_TWO_WEEKS",
                    "text": "Less than two weeks"
                  },
                  {
                    "value": "TWO_TO_FOUR_WEEKS",
                    "text": "Two to four weeks"
                  },
                  {
                    "value": "FOUR_TO_EIGHT_WEEKS",
                    "text": "Four to eight weeks"
                  },
                  {
                    "value": "OVER_EIGHT_WEEKS",
                    "text": "More than eight weeks"
                  }
                ],
                "showOtherItem": false
                }
              ]
            },
            {
              "type": "html",
              "name": "ProcedureUALSurgeryOpHeading",
              "html": "<h4>These questions ask about any issues {CmpnName} had immediately after surgery.</h4>"
            },
            {
              "type": "panel",
              "name": "ProcedureUALSurgeryPanel",
              "elements": [
                {
                  "type": "radiogroup",
                  "name": "ProcedureUALIncisionComplications",
                  "title": "Did {CmpnName} have any infection or swelling at the incision site?",
                  "isRequired": true,
                  "choices": [
                    {
                      "value": "YES",
                      "text": "Yes"
                    },
                    {
                      "value": "NO",
                      "text": "No"
                    },
                    {
                      "value": "DONT_KNOW",
                      "text": "Don't know"
                    }
                  ]
                },
                {
                  "type": "radiogroup",
                  "name": "ProcedureUALOralBleeding",
                  "title": "Did {CmpnName} have bleeding in the mouth or from the inside the throat?",
                  "isRequired": true,
                  "choices": [
                    {
                      "value": "YES",
                      "text": "Yes"
                    },
                    {
                      "value": "NO",
                      "text": "No"
                    },
                    {
                      "value": "DONT_KNOW",
                      "text": "Don't know"
                    }
                  ]
                },
                {
                  "type": "radiogroup",
                  "name": "ProcedureUALExtendedStay",
                  "title": "Did {CmpnName} have stay longer than expected at the hospital after the procedure?",
                  "isRequired": true,
                  "choices": [
                    {
                      "value": "NO",
                      "text": "No"
                    },
                    {
                      "value": "ONE_DAY",
                      "text": "Yes, one extra day"
                    },
                    {
                      "value": "TWO_DAYS",
                      "text": "Yes, two days"
                    },
                    {
                      "value": "THREE_DAYS",
                      "text": "Yes, three days or more"
                    }
                  ],
                  "showOtherItem": false
                },
                {
                  "type": "checkbox",
                  "name": "ProcedureUALExtendedStayReason",
                  "title": "Why did {CmpnName} need extended inpatient care?",
                  "isRequired": true,
                  "choices": [
                    {
                      "value": "ASPIRATION",
                      "text": "Aspiration pneumonia"
                    },
                    {
                      "value": "ANESTHESIA",
                      "text": "Adverse reaction to anesthesia"
                    },
                    {
                      "value": "SUTURE_FAILURE",
                      "text": "Suture failure"
                    },
                    {
                      "value": "RESPIRATORY",
                      "text": "Respiratory crisis"
                    },
                    {
                      "value": "STROKE",
                      "text": "Stroke or cardiac event"
                    }
                  ],
                  "showOtherItem": true
                },
                {
                  "type": "radiogroup",
                  "name": "ProcedureUALPeriopTiebackRepeat",
                  "title": "Did the surgeon attempt a second tieback on the other side?",
                  "isRequired": true,
                  "visibleIf": "{ProcedureUALExtendedStayReason} contains 'SUTURE_FAILURE'",
                  "choices": [
                    {
                      "value": "YES",
                      "text": "Yes"
                    },
                    {
                      "value": "NO",
                      "text": "No"
                    },
                    {
                      "value": "DONT_KNOW",
                      "text": "Don't know"
                    }
                  ]
                },
                {
                  "type": "radiogroup",
                  "name": "ProcedureUALFollowupCare",
                  "title": "Did CmpnName need another visit to a veterinary professional because of complications, not including the scheduled post-operative follow-up?",
                  "isRequired": true,
                  "choices": [
                    {
                      "value": "YES",
                      "text": "Yes"
                    },
                    {
                      "value": "NO",
                      "text": "No"
                    },
                    {
                      "value": "DONT_KNOW",
                      "text": "Don't know"
                    }
                  ],
                  "showOtherItem": false
                }
              ]
            }

          ]
        },

        {
          "type": "panel",
          "name": "ProcedureEFIPanel",
          "visibleIf": "{ProcedureDidHave} = true && {ProcedureType} contains 'EFI'",
          "elements": [

            {
              "type": "dropdown",
              "name": "ProcedureEFIType",
              "title": "What type of stent implant did {CmpnName} receive?",
              "isRequired": true,
              "choices": [
                {
                  "value": "SILICONE",
                  "text": "Silicone"
                },
                {
                  "value": "DEXSTENT",
                  "text": "Dextronix DexStent LE Nitinol wire"
                },
                {
                  "value": "NITINOL_MESH",
                  "text": "Nitinol mesh"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ],
              "showOtherItem": true
            },
            {
              "type": "panel",
              "name": "ProcedureEFIDexstentPanel",
              "visibleIf": "{ProcedureEFIType} contains 'DEXSTENT'",
              "elements": [
                {
                  "type": "html",
                  "name": "ProcedureEFIDexstentText",
                  "html": "<b>IMPORTANT</b>: The Dextronix DexStent LE Nitinol wire stent device has been discontinued by the manufacturer. Report parties involved in the sale or use of this device to your local veterinary regulatory agency."
                }
              ]
            }
          ]
        },

        {
          "type": "panel",
          "name": "ProcedureBVEAPPanel",
          "title": "Questions about {CmpnName}'s BVEAP surgery",
          "visibleIf": "{ProcedureDidHave} = true && {ProcedureType} contains 'BVEAP'",
          "elements": [
            {
              "type": "checkbox",
              "name": "ProcedureBVEAPReasons",
              "title": "Why did you choose this over other surgery types?",
              "description": "Please choose all that apply.",
              "isRequired": true,
              "choices": [
                {
                  "value": "COST",
                  "text": "Cost of this surgery compared to other surgery types"
                },
                {
                  "value": "RECOMMEND_PRIMARY",
                  "text": "Recommended by primary veterinarian"
                },
                {
                  "value": "RECOMMENDED_SPECIALIST",
                  "text": "Recommended by surgeon or specialist"
                },
                {
                  "value": "AVAILABILITY",
                  "text": "Availablility"
                }
              ],
              "showOtherItem": true
            }

          ]
        },
        
