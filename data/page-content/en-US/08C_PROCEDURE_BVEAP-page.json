{
  "name": "PROCEDURE_BVEAP-page",
  "visibleIf": "{ProcedureDidHave} = true and {ProcedureType} contains 'BVEAP'",
  "elements": [
    {
      "type": "panel",
      "name": "ProcedureBVEAPCard1Panel",
      "elements": [
        {
              "type": "html",
              "name": "ProcedureBVEAPHeading",
              "html": "<h2>Questions About {CmpnName}'s BVEAP Surgery<h2>"
        },
        {
          "type": "panel",
          "name": "ProcedureBVEAPAgePanel",

          "title": "About how old was {CmpnName} when {cvGenderSubjectPronoun} had the mean it BVEAP surgery for LP?",
          "elements": [
            {
              "type": "panel",
              "name": "ProcedureBVEAPAgeDetailsPanel",
              "description": "Please enter years and months.",
              "visibleIf": "{ProcedureDidHave} = true",
              "elements": [
                {
                  "type": "text",
                  "inputType": "number",
                  "name": "ProcedureBVEAPAgeYears",
                  "title": "Years",
                  "isRequired": true,
                  "min": "1",
                  "max": "40",
                    "validators": [
                    {
                      "type": "numeric",
                      "minValue": 1,
                      "maxValue": 40,
                      "text": "Age must be between 1 and 40"
                    }
                  ]
                },
                {
                  "type": "text",
                  "inputType": "number",
                  "name": "ProcedureBVEAPAgeMonths",
                  "title": "Months (0 - 11)",
                  "isRequired": true,
                  "min": 0,
                  "max": 11,
                  "validators": [
                    {
                      "type": "numeric",
                      "minValue": 0,
                      "maxValue": 11,
                      "text": "Months must be between 0 and 11"
                    }
                  ]
                }
              ]
            },
            {
              "type": "boolean",
              "name": "ProcedureBVEAPScheduled",
              "title": "Was it a scheduled procedure or an emergency procedure due to an LP-induced breathing crisis?",
              "isRequired": true,
              "visibleIf": "{ProcedureDidHave} = true",
              "labelTrue": "Scheduled",
              "labelFalse": "Emergency",
              "swapOrder": true
            },
            {
            "type": "dropdown",
            "name": "ProcedureBVEAPScheduledWait",
            "title": "How far in advance was the procedure scheduled?",
            "isRequired": true,
            "visibleIf": "{ProcedureDidHave} = true && {ProcedureBVEAPScheduled} = true",
            "choices": [
              {
                "value": "LESS_THAN_TWO_WEEKS",
                "text": "Less than two weeks"
              },
              {
                "value": "TWO_TO_FOUR_WEEKS",
                "text": "Two to four weeks"
              },
              {
                "value": "FOUR_TO_EIGHT_WEEKS",
                "text": "Four to eight weeks"
              },
              {
                "value": "OVER_EIGHT_WEEKS",
                "text": "More than eight weeks"
              }
            ],
            "showOtherItem": false
            },
            {
              "type": "radiogroup",
              "name": "ProcedureBVEAPDifference",
              "title": "Did the surgeon explain the difference between BVEAP and other surgery or procedure types?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },
            {
              "type": "radiogroup",
              "name": "ProcedureBVEAPChoice",
              "title": "Did the surgeon offer you a choice between BVEAP and any other procedure type?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            }
          ]
        },
        {
          "type": "panel",
          "name": "ProcedureBVEAPSurgeryPanel",
          "elements": [
            {
              "type": "html",
              "name": "ProcedureBVEAPPostOpHeading",
              "html": "<h4>These questions ask about issues {CmpnName} had immediately after surgery.</h4>"
            },
            {
              "type": "radiogroup",
              "name": "ProcedureBVEAPIncisionComplications",
              "title": "Did {CmpnName} have any infection or swelling at the incision site?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },
            {
              "type": "radiogroup",
              "name": "ProcedureBVEAPOralBleeding",
              "title": "Did {CmpnName} have bleeding in the mouth or from the inside the throat?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },

            {
              "type": "radiogroup",
              "name": "ProcedureBVEAPComplications",
              "title": "Were there unexpected complications during or immediately after the surgery?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },

            {
              "type": "checkbox",
              "name": "ProcedureBVEAPComplicationsType",
              "title": "What was the nature of the complications that occurred during or immediately after the surgery?",
              "isRequired": true,
              "visibleIf": "{ProcedureBVEAPComplications} = 'YES'",
              "choices": [
                {
                  "value": "ASPIRATION",
                  "text": "Aspiration pneumonia"
                },
                {
                  "value": "ANESTHESIA",
                  "text": "Adverse reaction to anesthesia"
                },
                {
                  "value": "SUTURE_FAILURE",
                  "text": "Suture failure"
                },
                {
                  "value": "RESPIRATORY",
                  "text": "Respiratory crisis"
                },
                {
                  "value": "STROKE",
                  "text": "Stroke or cardiac event"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know or prefer not to say"
                }
              ],
              "showOtherItem": true
            },

            {
              "type": "radiogroup",
              "name": "ProcedureBVEAPExtendedStay",
              "title": "Did {CmpnName} need to stay longer than expected at the hospital after the procedure?",
              "isRequired": true,
              "choices": [
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "ONE_DAY",
                  "text": "Yes, one extra day"
                },
                {
                  "value": "TWO_DAYS",
                  "text": "Yes, two days"
                },
                {
                  "value": "THREE_DAYS",
                  "text": "Yes, three days or more"
                }
              ],
              "showOtherItem": false
            },

            {
              "type": "radiogroup",
              "name": "ProcedureBVEAPFollowupCare",
              "title": "In the four weeks after surgery, did {CmpnName} need another visit to a veterinary professional because of complications?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ],
              "showOtherItem": false
            },
            {
              "type": "radiogroup",
              "name": "ProcedureBVEAPMedications",
              "title": "Were prescription medications provided for {CmpnName} after the procedure?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },
            {
              "type": "checkbox",
              "name": "ProcedureBVEAPMedicationsType",
              "title": "What medications were prescribed or provided for {CmpnName} after the procedure?",
              "isRequired": true,
              "visibleIf": "{ProcedureBVEAPMedications} = 'YES'",
              "choices": [
                {
                  "value": "PAIN",
                  "text": "Pain medications (i.e. acetaminophen, paracetamol or other NSAID, opiods)"
                },
                {
                  "value": "REFLUX",
                  "text": "Reflux medications (i.e. cisipride, famotidine, omeprazole)"
                },
                {
                  "value": "ANTIBIOTICS",
                  "text": "Antibiotics"
                },
                {
                  "value": "STEROID",
                  "text": "Steroid (i.e. prednisone, meloxicam, metacam)"
                },
                {
                  "value": "SEDATIVE",
                  "text": "Sedative (i.e. trazodone, gabapentin, acepromazine)"
                },
                {
                  "value": "MAROPITANT",
                  "text": "Cerenia (maropitant citrate)"
                },
                {
                  "value": "COUGH_SUPPRESSANT",
                  "text": "Cough suppressants (i.e. codeine, dextromethorphan, guaifenesin)"
                }
              ],
              "showOtherItem": true
            }
          ]
        },



        {
          "type": "panel",
          "name": "ProcedureBVEAPCostPanel",
          "elements": [
            {
              "type": "html",
              "name": "ProcedureBVEAPCostHeading",
              "html": "<h4>These questions are about the approximate cost of the surgery. Rough estimates are fine.</h4>"
            },
            {
              "type": "dropdown",
              "name": "ProcedureBVEAPCost",
              "title": "About what was the cost of the surgery, not including post-operative complications?",
              "description": "Please provide the pre-insurance cost, not the out-of-pocket cost.",
              "isRequired": true,
              "visibleIf": "{ProcedureDidHave} = true",
              "choices": [
                {
                  "value": "NOT_SAY",
                  "text": "Don't know or prefer not to say"
                },
                {
                  "value": "UNDER_1500",
                  "text": "Under $1500"
                },
                {
                  "value": "1500_3000",
                  "text": "$1500 - $3000"
                },
                {
                  "value": "3000_5000",
                  "text": "$3000 - $5000"
                },
                {
                  "value": "5000_7000",
                  "text": "$5000 - $7000"
                },
                {
                  "value": "7000_9000",
                  "text": "$7000 - $9000"
                },
                {
                  "value": "OVER_9000",
                  "text": "Over $9000"
                }
              ],
              "showOtherItem": false
            },
            {
              "type": "dropdown",
              "name": "ProcedureBVEAPFollowupCost",
              "title": "About what was total cost of the complications of the surgery?",
              "description": "Please provide the pre-insurance cost, not the out-of-pocket cost.",
              "isRequired": true,
              "visibleIf": "{ProcedureBVEAPFollowupCare} = 'YES'",
              "choices": [
                {
                  "value": "NOT_SAY",
                  "text": "Don't know or prefer not to say"
                },
                {
                  "value": "UNDER_500",
                  "text": "Under $500"
                },
                {
                  "value": "500_1000",
                  "text": "$500 - $1000"
                },
                {
                  "value": "1000_2000",
                  "text": "$1000 - $2000"
                },
                {
                  "value": "2000_3000",
                  "text": "$2000 - $3000"
                },
                {
                  "value": "3000_5000",
                  "text": "$3000 - $5000"
                },
                {
                  "value": "OVER_5000",
                  "text": "Over $5000"
                }
              ],
              "showOtherItem": false
            }
          ]
        }


      ]
    },

    {
      "type": "panel",
      "name": "ProcedureBVEAPCard2Panel",
      "elements": [
        {
          "type": "panel",
          "name": "ProcedureBVEAPConditionPanel",
          "elements": [
            {
              "type": "html",
              "name": "ProcedureBVEAPConditionHeading",
              "html": "<h4>These questions are about {CmpnName}'s condition in the weeks after the surgery.</h4>"
            },
    

            {
              "type": "rating",
              "name": "ProcedureBVEAPBreathingPostOp",
              "title": "How would you rate {CmpnName}'s breathing in the time right after the BVEAP surgery?",
              "description": "1 = no improvement, 3 = moderate improvement, 5 = very much improved",
              "isRequired": true,
              "rateValues": [
                { "value": 1, "text": "1" },
                { "value": 2, "text": "2" },
                { "value": 3, "text": "3" },
                { "value": 4, "text": "4" },
                { "value": 5, "text": "5" }
              ]
            },


            {
              "type": "radiogroup",
              "name": "ProcedureBVEAPCoughGagRetch",
              "title": "Did {CmpnName} cough, gag, or retch more than before the procedure?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },
            {
              "type": "rating",
              "name": "ProcedureBVEAPCoughGagRetchChange",
              "title": "Did the coughing, gagging or retching get worse or better with time?",
              "description": "1 = much worse, 3 = stayed about the same, 5 = got much better",
              "isRequired": true,
              "visibleIf": "{ProcedureBVEAPCoughGagRetch} = 'YES'",
              "rateValues": [
                { "value": 1, "text": "1" },
                { "value": 2, "text": "2" },
                { "value": 3, "text": "3" },
                { "value": 4, "text": "4" },
                { "value": 5, "text": "5" }
              ]
            },
            {
              "type": "radiogroup",
              "name": "ProcedureBVEAPBadBreath",
              "title": "Did {CmpnName} develop bad breath after the procedure?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },
            {
              "type": "rating",
              "name": "ProcedureBVEAPBadBreathChange",
              "title": "Did the bad breath get worse or better over time?",
              "description": "1 = much worse, 3 = stayed about the same, 5 = got much better",
              "isRequired": true,
              "visibleIf": "{ProcedureBVEAPBadBreath} = 'YES'",
              "rateValues": [
                { "value": 1, "text": "1" },
                { "value": 2, "text": "2" },
                { "value": 3, "text": "3" },
                { "value": 4, "text": "4" },
                { "value": 5, "text": "5" }
              ]
            },
            {
              "type": "radiogroup",
              "name": "ProcedureBVEAPRegurgitate",
              "title": "Did {CmpnName} regurgitate food or water more frequently than before the procedure?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },
            {
              "type": "rating",
              "name": "ProcedureBVEAPRegurgitateChange",
              "title": "Did the regurgitating get worse or better over time?",
              "description": "1 = much worse, 3 = stayed about the same, 5 = much better",
              "isRequired": true,
              "visibleIf": "{ProcedureBVEAPRegurgitate} = 'YES'",
              "rateValues": [
                { "value": 1, "text": "1" },
                { "value": 2, "text": "2" },
                { "value": 3, "text": "3" },
                { "value": 4, "text": "4" },
                { "value": 5, "text": "5" }
              ]
            },
            {
              "type": "radiogroup",
              "name": "ProcedureBVEAPMucus",
              "title": "Did {CmpnName} cough up mucus or phlegm more frequently than before the procedure?",
              "isRequired": true,
              
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },
            {
              "type": "rating",
              "name": "ProcedureBVEAPMucusChange",
              "title": "Did the mucus or phlegm production get worse or better over time?",
              "description": "1 = much worse, 3 = stayed about the same, 5 = much better",
              "isRequired": true,
              "visibleIf": "{ProcedureBVEAPMucus} = 'YES'",
              "rateValues": [
                { "value": 1, "text": "1" },
                { "value": 2, "text": "2" },
                { "value": 3, "text": "3" },
                { "value": 4, "text": "4" },
                { "value": 5, "text": "5" }
              ]
            }
          ]
        },
        {
          "type": "panel",
          "name": "ProcedureBVEAPLongTermPanel",
          "elements": [
            {
              "type": "html",
              "name": "ProcedureBVEAPLongTermHeading",
              "html": "<h4>These questions are about the long-term effects of {CmpnName}'s BVEAP surgery.</h4>"
            },
            {
              "type": "radiogroup",
              "name": "ProcedureBVEAPBreathingLongTerm",
              "title": "In the long-term, how did {CmpnName}'s breathing change over time after the surgery?",
              "isRequired": true,
              "choices": [
                {
                  "value": "NO_CHANGE",
                  "text": "No change"
                },
                {
                  "value": "PROGRESSIVELY_BETTER",
                  "text": "Got progressively better over time"
                },
                {
                  "value": "PROGRESSIVELY_WORSE",
                  "text": "Got progressively worse over time"
                },
                {
                  "value": "SYMPTOMS_RETURNED",
                  "text": "After initial improvement, all the LP symptoms returned"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },
            {
              "type": "dropdown",
              "name": "ProcedureBVEAPSymptomsReturnedTime",
              "title": "How long did it take for the LP symptoms to return?",
              "isRequired": true,
              "visibleIf": "{ProcedureBVEAPBreathingLongTerm} = 'SYMPTOMS_RETURNED'",
              "choices": [
                {
                  "value": "IMMEDIATELY",
                  "text": "Almost immediately"
                },
                {
                  "value": "WEEKS",
                  "text": "Several weeks"
                },
                {
                  "value": "MONTHS",
                  "text": "Several months"
                },
                {
                  "value": "YEAR",
                  "text": "Over a year"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't remember or don't know"
                }
              ],
              "showOtherItem": false
            },
            {
              "type": "rating",
              "name": "ProcedureBVEAPSatisfaction",
              "title": "How would you rate your satisfaction with {CmpnName}'s BVEAP procedure?",
              "description": "1 = not at all satisfied, 3 = moderately satisfied, 5 = very satisfied",
              "isRequired": true,
              "rateValues": [
                { "value": 1, "text": "1" },
                { "value": 2, "text": "2" },
                { "value": 3, "text": "3" },
                { "value": 4, "text": "4" },
                { "value": 5, "text": "5" }
              ]
            }
          ]
        }
      ]
    }
  ]
}