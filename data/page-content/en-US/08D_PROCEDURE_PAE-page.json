{
  "name": "PROCEDURE_PAE-page",
  "visibleIf": "{ProcedureDidHave} = true and {ProcedureType} contains 'PAE'",
  "elements": [
    {
      "type": "panel",
      "name": "ProcedurePAECard1Panel",
      "elements": [
        {
          "type": "panel",
          "name": "ProcedurePAEHeadPanel",
          "elements": [
            {
            "type": "html",
            "name": "ProcedurePAEHeading",
            "html": "<h2>{CmpnName}'s Arytenoidectomy Surgery</h2>"
            },
            {
              "type": "html",
              "name": "ProcedurePAEText",
              "html": "This section asks questions about the {CmpnName}'s arytenoidectomy surgery."
            },
            {
                  "type": "html",
                  "name": "ProcedurePAEText",
                  "html": "<p>The arytenoid cartilages are the parts of the larynx that are paralyzed, causing a blockage of the airway. Partial arytenoidectomy removes part of one side of the arytenoid cartilage to open up a space to breathe through.</p>"
            }
          ]
        },
        {
          "type": "panel",
          "name": "ProcedurePAEAgePanel",
          "title": "About how old was {CmpnName} when {cvGenderSubjectPronoun} had the artytenoidectomy surgery for LP?",
          "elements": [
            {
              "type": "panel",
              "name": "ProcedurePAEAgeDetailsPanel",
              "description": "Please enter years and months.",
              "visibleIf": "{ProcedureDidHave} = true",
              "elements": [
                {
                  "type": "text",
                  "inputType": "number",
                  "name": "ProcedurePAEAgeYears",
                  "title": "Years",
                  "isRequired": true,
                  "min": "1",
                  "max": "40",
                    "validators": [
                    {
                      "type": "numeric",
                      "minValue": 1,
                      "maxValue": 40,
                      "text": "Age must be between 1 and 40"
                    }
                  ]
                },
                {
                  "type": "text",
                  "inputType": "number",
                  "name": "ProcedurePAEAgeMonths",
                  "title": "Months (0 - 11)",
                  "isRequired": true,
                  "min": 0,
                  "max": 11,
                  "validators": [
                    {
                      "type": "numeric",
                      "minValue": 0,
                      "maxValue": 11,
                      "text": "Months must be between 0 and 11"
                    }
                  ]
                }
              ]
            },
            {
              "type": "boolean",
              "name": "ProcedurePAEScheduled",
              "title": "Was it a scheduled procedure or an emergency procedure due to an LP-induced breathing crisis?",
              "isRequired": true,
              "visibleIf": "{ProcedureDidHave} = true",
              "labelTrue": "Scheduled",
              "labelFalse": "Emergency",
              "swapOrder": true
            },
            {
            "type": "dropdown",
            "name": "ProcedurePAEScheduledWait",
            "title": "How far in advance was the procedure scheduled?",
            "isRequired": true,
            "visibleIf": "{ProcedureDidHave} = true && {ProcedurePAEScheduled} = true",
            "choices": [
              {
                "value": "LESS_THAN_TWO_WEEKS",
                "text": "Less than two weeks"
              },
              {
                "value": "TWO_TO_FOUR_WEEKS",
                "text": "Two to four weeks"
              },
              {
                "value": "FOUR_TO_EIGHT_WEEKS",
                "text": "Four to eight weeks"
              },
              {
                "value": "OVER_EIGHT_WEEKS",
                "text": "More than eight weeks"
              }
            ],
            "showOtherItem": false
            },
            {
              "type": "radiogroup",
              "name": "ProcedurePAEDifference",
              "title": "Did the surgeon explain the difference between the partial arytenoidectomy and other surgery or procedure types?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },

            {
              "type": "radiogroup",
              "name": "ProcedurePAELaser",
              "title": "Was the arytenoidectomy performed with a laser?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },

            {
              "type": "radiogroup",
              "name": "ProcedurePAEChoice",
              "title": "Did the surgeon offer you a choice between partial arytenoidectomy and any other procedure type?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            }
          ]
        },
        {
          "type": "panel",
          "name": "ProcedurePAESurgeryPanel",
          "elements": [
            {
              "type": "html",
              "name": "ProcedurePAEPostOpHeading",
              "html": "<h4>These questions ask about issues {CmpnName} had immediately after surgery.</h4>"
            },
            {
              "type": "radiogroup",
              "name": "ProcedurePAEIncisionComplications",
              "title": "Did {CmpnName} have any infection or swelling at the incision site?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },
            {
              "type": "radiogroup",
              "name": "ProcedurePAEOralBleeding",
              "title": "Did {CmpnName} have bleeding in the mouth or from the inside the throat?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },


            {
              "type": "radiogroup",
              "name": "ProcedurePAEComplications",
              "title": "Were there unexpected complications during or immediately after the surgery?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },

            {
              "type": "checkbox",
              "name": "ProcedurePAEComplicationsType",
              "title": "What was the nature of the complications that occurred during or immediately after the surgery?",
              "isRequired": true,
              "visibleIf": "{ProcedurePAEComplications} = 'YES'",
              "choices": [
                {
                  "value": "ASPIRATION",
                  "text": "Aspiration pneumonia"
                },
                {
                  "value": "ANESTHESIA",
                  "text": "Adverse reaction to anesthesia"
                },
                {
                  "value": "RESPIRATORY",
                  "text": "Respiratory crisis"
                },
                {
                  "value": "STROKE",
                  "text": "Stroke or cardiac event"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know or prefer not to say"
                }
              ],
              "showOtherItem": true
            },


            {
              "type": "radiogroup",
              "name": "ProcedurePAEExtendedStay",
              "title": "Did {CmpnName} need to stay longer than expected at the hospital after the procedure?",
              "isRequired": true,
              "choices": [
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "ONE_DAY",
                  "text": "Yes, one extra day"
                },
                {
                  "value": "TWO_DAYS",
                  "text": "Yes, two days"
                },
                {
                  "value": "THREE_DAYS",
                  "text": "Yes, three days or more"
                }
              ],
              "showOtherItem": false
            },


            {
              "type": "radiogroup",
              "name": "ProcedurePAEFollowupCare",
              "title": "In the four weeks after surgery, did {CmpnName} need another visit to a veterinary professional because of complications?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ],
              "showOtherItem": false
            },
            {
              "type": "radiogroup",
              "name": "ProcedurePAEMedications",
              "title": "Were prescription medications provided for {CmpnName} after the procedure?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },
            {
              "type": "checkbox",
              "name": "ProcedurePAEMedicationsType",
              "title": "What medications were prescribed or provided for {CmpnName} after the procedure?",
              "isRequired": true,
              "visibleIf": "{ProcedurePAEMedications} = 'YES'",
              "choices": [
                {
                  "value": "PAIN",
                  "text": "Pain medications (i.e. acetaminophen, paracetamol or other NSAID, opiods)"
                },
                {
                  "value": "REFLUX",
                  "text": "Reflux medications (i.e. cisipride, famotidine, omeprazole)"
                },
                {
                  "value": "ANTIBIOTICS",
                  "text": "Antibiotics"
                },
                {
                  "value": "STEROID",
                  "text": "Steroid (i.e. prednisone, meloxicam, metacam)"
                },
                {
                  "value": "SEDATIVE",
                  "text": "Sedative (i.e. trazodone, gabapentin, acepromazine)"
                },
                {
                  "value": "MAROPITANT",
                  "text": "Cerenia (maropitant citrate)"
                },
                {
                  "value": "COUGH_SUPPRESSANT",
                  "text": "Cough suppressants (i.e. codeine, dextromethorphan, guaifenesin)"
                }
              ],
              "showOtherItem": true
            }
          ]
        },



        {
          "type": "panel",
          "name": "ProcedurePAECostPanel",
          "elements": [
            {
              "type": "html",
              "name": "ProcedurePAECostHeading",
              "html": "<h4>These questions are about the approximate cost of the surgery. Rough estimates are fine.</h4>"
            },
            {
              "type": "dropdown",
              "name": "ProcedurePAECost",
              "title": "About what was the cost of the surgery, not including post-operative complications?",
              "description": "Please provide the pre-insurance cost, not the out-of-pocket cost.",
              "isRequired": true,
              "visibleIf": "{ProcedureDidHave} = true",
              "choices": [
                {
                  "value": "NOT_SAY",
                  "text": "Don't know or prefer not to say"
                },
                {
                  "value": "UNDER_1500",
                  "text": "Under $1500"
                },
                {
                  "value": "1500_3000",
                  "text": "$1500 - $3000"
                },
                {
                  "value": "3000_5000",
                  "text": "$3000 - $5000"
                },
                {
                  "value": "5000_7000",
                  "text": "$5000 - $7000"
                },
                {
                  "value": "7000_9000",
                  "text": "$7000 - $9000"
                },
                {
                  "value": "OVER_9000",
                  "text": "Over $9000"
                }
              ],
              "showOtherItem": false
            },
            {
              "type": "dropdown",
              "name": "ProcedurePAEFollowupCost",
              "title": "About what was total cost of follow-up care or procedures that {CmpnName} needed as a result of the surgery?",
              "description": "Please provide the pre-insurance cost, not the out-of-pocket cost.",
              "isRequired": true,
              "visibleIf": "{ProcedurePAEFollowupCare} = 'YES'",
              "choices": [
                {
                  "value": "NOT_SAY",
                  "text": "Don't know or prefer not to say"
                },
                {
                  "value": "UNDER_500",
                  "text": "Under $500"
                },
                {
                  "value": "500_1000",
                  "text": "$500 - $1000"
                },
                {
                  "value": "1000_2000",
                  "text": "$1000 - $2000"
                },
                {
                  "value": "2000_3000",
                  "text": "$2000 - $3000"
                },
                {
                  "value": "3000_5000",
                  "text": "$3000 - $5000"
                },
                {
                  "value": "OVER_5000",
                  "text": "Over $5000"
                }
              ],
              "showOtherItem": false
            }
          ]
        }


      ]
    },

    {
      "type": "panel",
      "name": "ProcedurePAECard2Panel",
      "elements": [
        {
          "type": "panel",
          "name": "ProcedurePAEConditionPanel",
          "elements": [
            {
              "type": "html",
              "name": "ProcedurePAEConditionHeading",
              "html": "<h4>These questions are about {CmpnName}'s condition in the weeks after the surgery.</h4>"
            },
    

            {
              "type": "rating",
              "name": "ProcedurePAEBreathingPostOp",
              "title": "How would you rate {CmpnName}'s breathing in the time right after the arytenoidectomy surgery?",
              "description": "1 = no improvement, 3 = moderate improvement, 5 = very much improved",
              "isRequired": true,
              "rateValues": [
                { "value": 1, "text": "1" },
                { "value": 2, "text": "2" },
                { "value": 3, "text": "3" },
                { "value": 4, "text": "4" },
                { "value": 5, "text": "5" }
              ]
            },


            {
              "type": "radiogroup",
              "name": "ProcedurePAECoughGagRetch",
              "title": "Did {CmpnName} cough, gag, or retch more than before the procedure?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
