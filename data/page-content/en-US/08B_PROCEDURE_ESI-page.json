{
  "name": "PROCEDURE_ESI-page",
  "visibleIf": "{ProcedureDidHave} = true and {ProcedureType} contains 'ESI'",
  "elements": [
    {
      "type": "panel",
      "name": "ProcedureESICard1Panel",
      "elements": [
        {
          "type": "panel",
          "name": "ProcedureESIHeadPanel",
          "elements": [
            {
              "type": "html",
              "name": "ProcedureESIHeading",
              "html": "<h2>{CmpnName}'s Stent Implant Procedure<h2>"
            },
            {
              "type": "html",
              "name": "ProcedureESIText",
              "html": "This section asks questions about {CmpnName}'s stent implant procedure."
            }

          ]
        },
        {
          "type": "panel",
          "name": "ProcedureESIAgePanel",
          "title": "At about what age did {CmpnName} have the stent procedure for LP/ GOLPP?",
          "elements": [
            {
              "type": "panel",
              "name": "ProcedureESIAgeDetailsPanel",
              "description": "Please enter years and months.",
              "visibleIf": "{ProcedureDidHave} = true",
              "elements": [
                {
                  "type": "text",
                  "inputType": "number",
                  "name": "ProcedureESIAgeYears",
                  "title": "Years",
                  "isRequired": true,
                  "min": "1",
                  "max": "40",
                    "validators": [
                    {
                      "type": "numeric",
                      "minValue": 1,
                      "maxValue": 40,
                      "text": "Age must be between 1 and 40"
                    }
                  ]
                },
                {
                  "type": "text",
                  "inputType": "number",
                  "name": "ProcedureESIAgeMonths",
                  "title": "Months (0 - 11)",
                  "isRequired": true,
                  "min": 0,
                  "max": 11,
                  "validators": [
                    {
                      "type": "numeric",
                      "minValue": 0,
                      "maxValue": 11,
                      "text": "Months must be between 0 and 11"
                    }
                  ]
                }
              ]
            },
            {
              "type": "boolean",
              "name": "ProcedureESIScheduled",
              "title": "Was it a scheduled procedure or an emergency procedure due to an LP-induced breathing crisis?",
              "isRequired": true,
              "visibleIf": "{ProcedureDidHave} = true",
              "labelTrue": "Scheduled",
              "labelFalse": "Emergency",
              "swapOrder": true
            },
            {
            "type": "dropdown",
            "name": "ProcedureESIScheduledWait",
            "title": "How far in advance was the procedure scheduled?",
            "isRequired": true,
            "visibleIf": "{ProcedureDidHave} = true && {ProcedureESIScheduled} = true",
            "choices": [
              {
                "value": "LESS_THAN_TWO_WEEKS",
                "text": "Less than two weeks"
              },
              {
                "value": "TWO_TO_FOUR_WEEKS",
                "text": "Two to four weeks"
              },
              {
                "value": "FOUR_TO_EIGHT_WEEKS",
                "text": "Four to eight weeks"
              },
              {
                "value": "OVER_EIGHT_WEEKS",
                "text": "More than eight weeks"
              }
            ],
            "showOtherItem": false
            },
            {
              "type": "radiogroup",
              "name": "ProcedureESIDifference",
              "title": "Did the surgeon explain the difference between the stent implant and other surgery or procedure types?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },
            {
              "type": "radiogroup",
              "name": "ProcedureESIChoice",
              "title": "Did the surgeon offer you a choice between the stent implant and any other procedure type?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            }
          ]
        },
        {
          "type": "panel",
          "name": "ProcedureESISurgeryPanel",
          "elements": [
            {
              "type": "html",
              "name": "ProcedureESIPostOpHeading",
              "html": "<h4>These questions ask about issues {CmpnName} had immediately after stent procedure.</h4>"
            },
            {
              "type": "radiogroup",
              "name": "ProcedureESIOralBleeding",
              "title": "Did {CmpnName} have bleeding in the mouth or from the inside the throat?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },
            {
              "type": "radiogroup",
              "name": "ProcedureESIExtendedStay",
              "title": "Did {CmpnName} need to stay longer than expected at the hospital after the procedure?",
              "isRequired": true,
              "choices": [
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "ONE_DAY",
                  "text": "Yes, one extra day"
                },
                {
                  "value": "TWO_DAYS",
                  "text": "Yes, two days"
                },
                {
                  "value": "THREE_DAYS",
                  "text": "Yes, three days or more"
                }
              ],
              "showOtherItem": false
            },

            {
              "type": "radiogroup",
              "name": "ProcedureESIComplications",
              "title": "Were there unexpected complications during or immediately after the surgery?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },


            {
              "type": "checkbox",
              "name": "ProcedureESIComplicationsType",
              "title": "What was the nature of the complications that occurred during or immediately after the surgery?",
              "isRequired": true,
              "visibleIf": "{ProcedureESIComplications} = 'YES'",
              "choices": [
                {
                  "value": "ASPIRATION",
                  "text": "Aspiration pneumonia"
                },
                {
                  "value": "ANESTHESIA",
                  "text": "Adverse reaction to anesthesia"
                },
                {
                  "value": "MIGRATED",
                  "text": "Stent moved or was coughed out"
                },
                {
                  "value": "RESPIRATORY",
                  "text": "Respiratory crisis"
                },
                {
                  "value": "STROKE",
                  "text": "Stroke or cardiac event"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know or prefer not to say"
                }
              ],
              "showOtherItem": true
            },
            {
              "type": "radiogroup",
              "name": "ProcedureESIComplicationsRepeatProcedure",
              "title": "Did the surgeon attempt to implant another stent of a different size?",
              "isRequired": true,
              "visibleIf": "{ProcedureESIComplicationsType} contains 'MIGRATED'",
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },
            {
              "type": "radiogroup",
              "name": "ProcedureESIFollowupCare",
              "title": "In the four weeks after the stent procedure, did {CmpnName} need another visit to a veterinary professional because of complications?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ],
              "showOtherItem": false
            },
            {
              "type": "radiogroup",
              "name": "ProcedureESIMedications",
              "title": "Were prescription medications provided for {CmpnName} after the procedure?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },
            {
              "type": "checkbox",
              "name": "ProcedureESIMedicationsType",
              "title": "What medications were prescribed or provided for {CmpnName} after the procedure?",
              "isRequired": true,
              "visibleIf": "{ProcedureESIMedications} = 'YES'",
              "choices": [
                {
                  "value": "PAIN",
                  "text": "Pain medications (i.e. acetaminophen, paracetamol or other NSAID, opiods)"
                },
                {
                  "value": "REFLUX",
                  "text": "Reflux medications (i.e. cisipride, famotidine, omeprazole)"
                },
                {
                  "value": "ANTIBIOTICS",
                  "text": "Antibiotics"
                },
                {
                  "value": "STEROID",
                  "text": "Steroid (i.e. prednisone, meloxicam, metacam)"
                },
                {
                  "value": "SEDATIVE",
                  "text": "Sedative (i.e. trazodone, gabapentin, acepromazine)"
                },
                {
                  "value": "MAROPITANT",
                  "text": "Cerenia (maropitant citrate)"
                },
                {
                  "value": "COUGH_SUPPRESSANT",
                  "text": "Cough suppressants (i.e. codeine, dextromethorphan, guaifenesin)"
                }
              ],
              "showOtherItem": true
            }
          ]
        },
        {
          "type": "panel",
          "name": "ProcedureESICostPanel",
          "elements": [
            {
              "type": "html",
              "name": "ProcedureESICostHeading",
              "html": "<h4>These questions are about the approximate cost of the stent procedure. Rough estimates are fine.</h4>"
            },
            {
              "type": "dropdown",
              "name": "ProcedureESICost",
              "title": "About what was the cost of the stent procedure, not including post-operative complications?",
              "description": "Please provide the pre-insurance cost, not the out-of-pocket cost.",
              "isRequired": true,
              "visibleIf": "{ProcedureDidHave} = true",
              "choices": [
                {
                  "value": "NOT_SAY",
                  "text": "Don't know or prefer not to say"
                },
                {
                  "value": "UNDER_1500",
                  "text": "Under $1500"
                },
                {
                  "value": "1500_3000",
                  "text": "$1500 - $3000"
                },
                {
                  "value": "3000_5000",
                  "text": "$3000 - $5000"
                },
                {
                  "value": "5000_7000",
                  "text": "$5000 - $7000"
                },
                {
                  "value": "7000_9000",
                  "text": "$7000 - $9000"
                },
                {
                  "value": "OVER_9000",
                  "text": "Over $9000"
                }
              ],
              "showOtherItem": false
            },
            {
              "type": "dropdown",
              "name": "ProcedureESIFollowupCost",
              "title": "About what was total cost of follow-up care or procedures that {CmpnName} needed as a result of the stent implant?",
              "description": "Please provide the pre-insurance cost, not the out-of-pocket cost.",
              "isRequired": true,
              "visibleIf": "{ProcedureESIFollowupCare} = 'YES'",
              "choices": [
                {
                  "value": "NOT_SAY",
                  "text": "Don't know or prefer not to say"
                },
                {
                  "value": "UNDER_500",
                  "text": "Under $500"
                },
                {
                  "value": "500_1000",
                  "text": "$500 - $1000"
                },
                {
                  "value": "1000_2000",
                  "text": "$1000 - $2000"
                },
                {
                  "value": "2000_3000",
                  "text": "$2000 - $3000"
                },
                {
                  "value": "3000_5000",
                  "text": "$3000 - $5000"
                },
                {
                  "value": "OVER_5000",
                  "text": "Over $5000"
                }
              ],
              "showOtherItem": false
            }
          ]
        }
      ]
    },
    {
      "type": "panel",
      "name": "ProcedureESICard2Panel",
      "elements": [
        {
          "type": "panel",
          "name": "ProcedureESIConditionPanel",
          "elements": [
            {
              "type": "html",
              "name": "ProcedureESIConditionHeading",
              "html": "<h4>These questions are about {CmpnName}'s condition in the weeks after the stent procedure.</h4>"
            },
            {
              "type": "rating",
              "name": "ProcedureESIBreathingPostOp",
              "title": "How would you rate {CmpnName}'s breathing in the time right after the stent implant?",
              "description": "1 = no improvement, 3 = moderate improvement, 5 = very much improved",
              "isRequired": true,
              "rateValues": [
                { "value": 1, "text": "1" },
                { "value": 2, "text": "2" },
                { "value": 3, "text": "3" },
                { "value": 4, "text": "4" },
                { "value": 5, "text": "5" }
              ]
            },
            {
              "type": "radiogroup",
              "name": "ProcedureESICoughGagRetch",
              "title": "Did {CmpnName} cough, gag, or retch more than before the procedure?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },
            {
              "type": "rating",
              "name": "ProcedureESICoughGagRetchChange",
              "title": "Did the coughing, gagging or retching get worse or better over time?",
              "description": "1 = much worse, 3 = stayed about the same, 5 = got much better",
              "isRequired": true,
              "visibleIf": "{ProcedureESICoughGagRetch} = 'YES'",
              "rateValues": [
                { "value": 1, "text": "1" },
                { "value": 2, "text": "2" },
                { "value": 3, "text": "3" },
                { "value": 4, "text": "4" },
                { "value": 5, "text": "5" }
              ]
            },
            {
              "type": "radiogroup",
              "name": "ProcedureESIBadBreath",
              "title": "Did {CmpnName} develop bad breath after the procedure?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },
            {
              "type": "rating",
              "name": "ProcedureESIBadBreathStrength",
              "title": "How strong was {CmpnName}'s bad breath?",
              "description": "1 = not very strong, 3 = moderate, 5 = extremely strong",
              "isRequired": true,
              "visibleIf": "{ProcedureType} contains 'ESI' && {ProcedureESIBadBreath} = 'YES'",
              "rateValues": [
                { "value": 1, "text": "1" },
                { "value": 2, "text": "2" },
                { "value": 3, "text": "3" },
                { "value": 4, "text": "4" },
                { "value": 5, "text": "5" }
              ]
            },
            {
              "type": "rating",
              "name": "ProcedureESIBadBreathChange",
              "title": "Did the bad breath get worse or better over time?",
              "description": "1 = much worse, 3 = stayed about the same, 5 = got much better",
              "isRequired": true,
              "visibleIf": "{ProcedureESIBadBreath} = 'YES'",
              "rateValues": [
                { "value": 1, "text": "1" },
                { "value": 2, "text": "2" },
                { "value": 3, "text": "3" },
                { "value": 4, "text": "4" },
                { "value": 5, "text": "5" }
              ]
            },
            {
              "type": "radiogroup",
              "name": "ProcedureESIRegurgitate",
              "title": "Did {CmpnName} regurgitate food or water more frequently than before the procedure?",
              "isRequired": true,
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },
            {
              "type": "rating",
              "name": "ProcedureESIRegurgitateChange",
              "title": "Did the regurgitating get worse or better over time?",
              "description": "1 = much worse, 3 = stayed about the same, 5 = much better",
              "isRequired": true,
              "visibleIf": "{ProcedureESIRegurgitate} = 'YES'",
              "rateValues": [
                { "value": 1, "text": "1" },
                { "value": 2, "text": "2" },
                { "value": 3, "text": "3" },
                { "value": 4, "text": "4" },
                { "value": 5, "text": "5" }
              ]
            },
            {
              "type": "radiogroup",
              "name": "ProcedureESIMucus",
              "title": "Did {CmpnName} cough up mucus or phlegm more frequently than before the procedure?",
              "isRequired": true,
              
              "choices": [
                {
                  "value": "YES",
                  "text": "Yes"
                },
                {
                  "value": "NO",
                  "text": "No"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },
            {
              "type": "rating",
              "name": "ProcedureESIMucusChange",
              "title": "Did the mucus or phlegm production get worse or better over time?",
              "description": "1 = much worse, 3 = stayed about the same, 5 = much better",
              "isRequired": true,
              "visibleIf": "{ProcedureESIMucus} = 'YES'",
              "rateValues": [
                { "value": 1, "text": "1" },
                { "value": 2, "text": "2" },
                { "value": 3, "text": "3" },
                { "value": 4, "text": "4" },
                { "value": 5, "text": "5" }
              ]
            }
          ]
        },
        {
          "type": "panel",
          "name": "ProcedureESILongTermPanel",
          "elements": [
            {
              "type": "html",
              "name": "ProcedureESILongTermHeading",
              "html": "<h4>These questions are about the long-term effects of {CmpnName}'s stent procedure.</h4>"
            },
            {
              "type": "radiogroup",
              "name": "ProcedureESIBreathingLongTerm",
              "title": "In the long-term, how did {CmpnName}'s breathing change over time after the stent procedure",
              "isRequired": true,
              "choices": [
                {
                  "value": "NO_CHANGE",
                  "text": "No change"
                },
                {
                  "value": "PROGRESSIVELY_BETTER",
                  "text": "Got progressively better with time"
                },
                {
                  "value": "PROGRESSIVELY_WORSE",
                  "text": "Got progressively worse over time"
                },
                {
                  "value": "SYMPTOMS_RETURNED",
                  "text": "After initial improvement, all the LP symptoms returned"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't know"
                }
              ]
            },
            {
              "type": "dropdown",
              "name": "ProcedureESISymptomsReturnedTime",
              "title": "How long did it take for the LP symptoms to return?",
              "isRequired": true,
              "visibleIf": "{ProcedureESIBreathingLongTerm} = 'SYMPTOMS_RETURNED'",
              "choices": [
                {
                  "value": "IMMEDIATELY",
                  "text": "Almost immediately"
                },
                {
                  "value": "WEEKS",
                  "text": "Several weeks"
                },
                {
                  "value": "MONTHS",
                  "text": "Several months"
                },
                {
                  "value": "YEAR",
                  "text": "Over a year"
                },
                {
                  "value": "DONT_KNOW",
                  "text": "Don't remember or don't know"
                }
              ],
              "showOtherItem": false
            },
            {
              "type": "boolean",
              "name": "ProcedureESILongTermRepeatProcedure",
              "title": "If the return of LP symptoms was because the stent migrated or was coughed out, did {CmpnName} have a second stent procedure?",
              "visibleIf": "{ProcedureESIBreathingLongTerm} = 'SYMPTOMS_RETURNED'",
              "labelTrue": "Yes",
              "labelFalse": "No",
              "isRequired": true,
              "swapOrder": true
            },
            {
              "type": "rating",
              "name": "ProcedureESISatisfaction",
              "title": "How would you rate your satisfaction with {CmpnName}'s stent implant?",
              "description": "1 = not at all satisfied, 3 = moderately satisfied, 5 = very satisfied",
              "isRequired": true,
              "rateValues": [
                { "value": 1, "text": "1" },
                { "value": 2, "text": "2" },
                { "value": 3, "text": "3" },
                { "value": 4, "text": "4" },
                { "value": 5, "text": "5" }
              ]
            }
          ]
        }
      ]
    }
  ]
}